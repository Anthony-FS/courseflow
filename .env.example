NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Required for QR payment enrollment (poll + webhook), forgot-password email lookup,
# and some admin local testing
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Omise test keys from https://dashboard.omise.co (never commit real secrets)
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_...
OMISE_SECRET_KEY=skey_test_...

# Password reset — Supabase Dashboard → Authentication → URL Configuration
# Add Redirect URLs:
#   http://localhost:3000/reset-password
#   http://localhost:3000/auth/confirm
# (and the same paths on your production domain)
#
# Recommended email template (Reset Password) for cross-device reset links:
#   <a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password">Reset Password</a>
#
# Default PKCE links redirect to /reset-password and are exchanged in the browser
# that requested the reset (same browser/device).
